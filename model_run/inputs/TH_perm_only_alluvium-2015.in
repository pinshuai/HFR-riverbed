## This is the hydrothermal input file modified based on flow model used by Chao in Neil's FloaTEM paper
## This geoframework is modified based on Pin's HFR-ugrid model by adding heter K to the to alluvium layer only (the rest of geology layers are kept constant)
## starting date: 2007-1-1 00:00:00
## PFLOTRAN version: PFLOTRAN Development Version (09/06/2024)
## PFLOTRAN_DIR: /global/common/software/pflotran/pflotran_intel/src/pflotran/pflotran
## ===============BEGINNING of FILE=========================
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
	SUBSURFACE_FLOW flow
      MODE TH
      # OPTIONS
      #   REVERT_PARAMETERS_ON_RESTART
      # /  
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
  /

#  skip
  CHECKPOINT
    PERIODIC TIME 720 h 
    FORMAT HDF5
  /
# noskip

 skip
  RESTART 
    FILENAME /pscratch/sd/p/pshuai/HFR-riverbed/TH_perm_only_alluvium/TH_perm_only_alluvium-720.0000h.h5
    # RESET_TO_TIME_ZERO
  END
 noskip

  INPUT_RECORD_FILE
END


SUBSURFACE
WALLCLOCK_STOP 23.5 h

#=======================chemistry========================
CHEMISTRY
  PRIMARY_SPECIES
    Tracer_river 
  /
  OUTPUT
    ALL
    TOTAL
  /
END
#=======================solver options========================
NUMERICAL_METHODS FLOW
TIMESTEPPER 
  TS_ACCELERATION 8 
  MAXIMUM_CONSECUTIVE_TS_CUTS 20 
  CFL_GOVERNOR 1.d0
    # INITIAL_TIMESTEP_SIZE 0.1d0 h
    # MAXIMUM_TIMESTEP_SIZE 6.d0 h
#  MAXIMUM_NUMBER_OF_TIMESTEPS 50
END

NEWTON_SOLVER 
  VERBOSE_LOGGING
  MAXIMUM_NUMBER_OF_ITERATIONS 20
#  RTOL 1.d-8
#  ATOL 1.d
#  STOL 1.d-8
  ITOL_UPDATE 1.d0
END

LINEAR_SOLVER
  SOLVER GMRES
  PRECONDITIONER ASM
/

END

NUMERICAL_METHODS TRANSPORT
TIMESTEPPER 
  TS_ACCELERATION 8
  MAXIMUM_CONSECUTIVE_TS_CUTS 20
/

NEWTON_SOLVER 
  NO_INFINITY_NORM
/

LINEAR_SOLVER
/

END

#=======================discretization========================
GRID
  TYPE unstructured /global/cfs/cdirs/m1800/pin/github/HFR-thorne/data/mesh/hanford_mesh_100m-updated-matID-river.h5
END
#=======================fluid properties========================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1e-09
END
#=======================datasets========================
 
  DATASET Initial_Head
    FILENAME /global/cfs/cdirs/m1800/pin/github/HFR-thorne/data/boundary_conditions/HFR_H_Initial.h5 
    HDF5_DATASET_NAME Initial_Head
  END
  
  DATASET perm_meanX 
    FILENAME /global/cfs/cdirs/m1800/pin/HFR-riverbed/data/perm_data_only_alluvium_smoothed_cutoff.h5
    HDF5_DATASET_NAME perm_meanX
  END

  DATASET perm_meanY 
    FILENAME /global/cfs/cdirs/m1800/pin/HFR-riverbed/data/perm_data_only_alluvium_smoothed_cutoff.h5
    HDF5_DATASET_NAME perm_meanY
  END

  DATASET perm_meanZ 
    FILENAME /global/cfs/cdirs/m1800/pin/HFR-riverbed/data/perm_data_only_alluvium_smoothed_cutoff.h5
    HDF5_DATASET_NAME perm_meanZ
  END

#=======================material properties========================
  MATERIAL_PROPERTY hanford 
    ID 1 
    POROSITY 0.2 
    TORTUOSITY 1 
    CHARACTERISTIC_CURVES cc1 
    PERMEABILITY
      ANISOTROPIC
      DATASET perm_mean 
    #PERM_X 7.368421e-09
    #PERM_Y 7.368421e-09
    #PERM_Z 7.368421e-10
    /
  ROCK_DENSITY 2760 
  SPECIFIC_HEAT 715 
  THERMAL_CONDUCTIVITY_DRY 1.76 
  THERMAL_CONDUCTIVITY_WET 1.876 
  END

