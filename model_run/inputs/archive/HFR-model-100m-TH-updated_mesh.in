## HFR unstructured model with flow and thermal transport
## 2023-3-1:mesh has been updated by using finer vertical resolution below riverbed and coarser horizontal resolution inland
## 2023-4-5:new observation points are added
## starting date: 2007-1-1 00:00:00
## PFLOTRAN version: pflotran-030821
## ===============BEGINNING of FILE=========================
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
  SUBSURFACE_FLOW flow
    MODE TH
  /
  SUBSURFACE_TRANSPORT transport
    MODE GIRT
  /
END

CHECKPOINT
  PERIODIC TIME 30 d 
  FORMAT HDF5
/

# skip
  RESTART 
    FILENAME ../TH-mesh_100m/HFR-model-100m-TH-updated_mesh-8688.0000h.h5
    RESET_TO_TIME_ZERO
  END
# noskip

INPUT_RECORD_FILE
END


SUBSURFACE
WALLCLOCK_STOP 47.9 h

#=======================chemistry========================
CHEMISTRY
  PRIMARY_SPECIES
    Tracer_river 
  /
  OUTPUT
    ALL
    TOTAL
/
END
#=======================solver options========================
NUMERICAL_METHODS FLOW
TIMESTEPPER 
  TS_ACCELERATION 8 
  MAXIMUM_CONSECUTIVE_TS_CUTS 20 
  CFL_GOVERNOR 1.d0
    # INITIAL_TIMESTEP_SIZE 0.1d0 h
    # MAXIMUM_TIMESTEP_SIZE 6.d0 h
#  MAXIMUM_NUMBER_OF_TIMESTEPS 50
END

NEWTON_SOLVER 
  VERBOSE_ERROR_MESSAGING
  MAXIMUM_NUMBER_OF_ITERATIONS 20
 RTOL 1.d-6   ! this is not default. Used higher threshold to allow convergence.
 ATOL 1.d-50
 STOL 1.d-6
 ITOL_UPDATE 1.d0
END

LINEAR_SOLVER
/

END

NUMERICAL_METHODS TRANSPORT
TIMESTEPPER 
  TS_ACCELERATION 8
  MAXIMUM_CONSECUTIVE_TS_CUTS 20
/

NEWTON_SOLVER 
  NO_INFINITY_NORM
/

LINEAR_SOLVER
/

END

#=======================discretization========================
GRID
  TYPE unstructured ../../data/mesh/hanford_mesh_100m-updated-matID-river.h5
END
#=======================fluid properties========================
FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1e-09
END
#=======================datasets========================
DATASET Initial_Head
  FILENAME ../../data/boundary_conditions/HFR_H_Initial.h5 
  HDF5_DATASET_NAME Initial_Head
END

# DATASET perm_meanX 
#   FILENAME ../inputs/HFR_unstructured_coarse_perm.h5 
# END

# DATASET perm_meanY 
#   FILENAME ../inputs/HFR_unstructured_coarse_perm.h5 
# END

# DATASET perm_meanZ 
#   FILENAME ../inputs/HFR_unstructured_coarse_perm.h5 
# END

#=======================material properties========================

MATERIAL_PROPERTY hanford 
  ID 1 
  POROSITY 0.2 
  TORTUOSITY 1 
  SATURATION_FUNCTION cc1 
  PERMEABILITY
  PERM_X 7.368421e-09 
  PERM_Y 7.368421e-09 
  PERM_Z 7.368421e-10 
  /
  ROCK_DENSITY 2760 
  SPECIFIC_HEAT 715 
  THERMAL_CONDUCTIVITY_DRY 1.76 
  THERMAL_CONDUCTIVITY_WET 1.876 
END

