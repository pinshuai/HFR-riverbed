MATERIAL_PROPERTY alluvium 
  ID 10 
  POROSITY 0.43 
  TORTUOSITY 1 
  CHARACTERISTIC_CURVES cc2 
  PERMEABILITY
  PERM_X 4.65e-13
  PERM_Y 4.65e-13
  PERM_Z 4.65e-13
  /
  ROCK_DENSITY 2650 
  SPECIFIC_HEAT 920 
  THERMAL_CONDUCTIVITY_DRY 0.684 
  THERMAL_CONDUCTIVITY_WET 0.9334 
END

#=======================saturation fuctions========================
CHARACTERISTIC_CURVES cc1 
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.3391 
    ALPHA 0.00072727 
    LIQUID_RESIDUAL_SATURATION 0.16 
    MAX_CAPILLARY_PRESSURE 1e+08 
  /
  PERMEABILITY_FUNCTION BURDINE_VG_LIQ
    SMOOTH
    M 0.3391 
    LIQUID_RESIDUAL_SATURATION 0.16 
  /
END

CHARACTERISTIC_CURVES cc2 
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.7479 
    ALPHA 0.00014319 
    LIQUID_RESIDUAL_SATURATION 0.1299 
    MAX_CAPILLARY_PRESSURE 1e+08 
  /
  PERMEABILITY_FUNCTION BURDINE_VG_LIQ
    SMOOTH
    M 0.7479 
    LIQUID_RESIDUAL_SATURATION 0.1299 
  /
END


#=======================output options========================
OUTPUT
  TIME_UNITS h
  VARIABLES
    LIQUID_PRESSURE
    LIQUID_SATURATION
    TEMPERATURE
  /
  SNAPSHOT_FILE
  PERIODIC TIME 120 h 
  # PERIODIC TIMESTEP 1
  FORMAT HDF5 SINGLE_FILE
  /

  MASS_BALANCE_FILE
  PERIODIC TIME 6 h 
  /

  OBSERVATION_FILE
  PERIODIC TIME 6 h 
  /

  VELOCITY_AT_CENTER
  VELOCITY_AT_FACE
 END


#=======================times========================
TIME
  FINAL_TIME 112487 hr 
#  FINAL_TIME 8640 hr 

  INITIAL_TIMESTEP_SIZE 0.01 h 
  MAXIMUM_TIMESTEP_SIZE 6 h 
END

